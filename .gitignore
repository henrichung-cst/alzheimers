# Public repo policy: track code, docs, and repo policy.
*
!/.gitignore
!/.gitmodules
!/vendor/
!/vendor/**
!/alz/
!/alz/**
!README.md
!CLAUDE.md
!/docs/
!/docs/**
!pixi.toml
!pixi.lock
!pyproject.toml
!.envrc
!/tests/
!/tests/**
!/conf/
!/conf/**
/conf/local/*
!/conf/local/.gitkeep
# Ignore generated Python cache files.
/alz/__pycache__/
/alz/**/*.pyc
/tests/__pycache__/
alz/integration/intermediates/
# pixi environments
.pixi/*
!.pixi/config.toml
# Archived docs and rendered artifacts — provenance on disk, not in git.
/docs/archive/
/docs/**/*.pdf
/docs/**/*.html
!/docs/probes/s3_gzip_probe/index.html
# bench/ is bulk reference data on disk; track only the parity-audit log.
!/bench/
/bench/*
!/bench/bench.md
