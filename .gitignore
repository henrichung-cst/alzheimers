# Public repo policy: track code, docs, and repo policy.
*
!/.gitignore
!/alz/
!/alz/**
!README.md
!CLAUDE.md
!/docs/
!/docs/**
!pixi.toml
!pixi.lock
!pyproject.toml
!.envrc
!/conf/
!/conf/**
/conf/local/*
!/conf/local/.gitkeep
# Ignore generated Python cache files.
/alz/__pycache__/
/alz/**/*.pyc
alz/integration/intermediates/
# pixi environments
.pixi/*
!.pixi/config.toml
# Archived docs and rendered artifacts — provenance on disk, not in git.
/docs/archive/
/docs/**/*.pdf
/docs/**/*.html
