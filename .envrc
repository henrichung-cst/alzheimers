# Layer-1 owned-drive mount (required for all work projects)
mountpoint -q ~/mnt/gdrive || { echo ".envrc: ~/mnt/gdrive not mounted — refusing to activate"; exit 1; }

# Ensure pixi is on PATH (direnv runs .envrc with bash, not fish)
PATH_add "$HOME/.pixi/bin"

# DuckDB spill dir — /tmp is tmpfs (RAM-backed) and OOMs on large spills
export DUCKDB_TEMP_DIR="$HOME/.cache/duckdb"
mkdir -p "$DUCKDB_TEMP_DIR"

# Suppress pixi/rattler CUDA virtual-package probe — nvidia-smi hangs intermittently
# on this shared box. Empty string = "no CUDA present", skips nvidia-smi entirely.
export CONDA_OVERRIDE_CUDA=""

# Activate pixi env
eval "$(pixi shell-hook)"
